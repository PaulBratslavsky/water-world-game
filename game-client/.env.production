# Production environment for Netlify deployment
# Game server URL - leave empty until game server is deployed
# Once deployed, set to: wss://your-game-server.railway.app
VITE_SOCKET_URL=

# Strapi CMS URL (already deployed)
VITE_STRAPI_URL=https://mindful-growth-1d34faa3a8.strapiapp.com

# Strapi API token - do NOT commit it here.
# Local `npm run deploy`: set VITE_STRAPI_API_TOKEN in .env.production.local (git-ignored).
# Builds on Netlify: set VITE_STRAPI_API_TOKEN in Site settings > Environment variables.
# Vite inlines this value into the public JS bundle, so use a custom token scoped to
# only what the client needs - never a full-access token.
